# ==========================================
# Moulay Travel — Environment Configuration
# ==========================================

# Site URL (used for SEO metadata & OpenGraph)
NEXT_PUBLIC_SITE_URL=https://moulaytravel.com

# Admin Panel Security (REQUIRED — no default fallback!)
ADMIN_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
ADMIN_SESSION_SECRET=CHANGE_ME_TO_A_RANDOM_64_CHAR_HEX_STRING

# Google Sheets Integration (Edge REST API)
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_OMRA_ID=your_omra_and_hotels_sheet_id
GOOGLE_SHEET_AUTRES_ID=your_other_services_sheet_id

# Firebase Client Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
